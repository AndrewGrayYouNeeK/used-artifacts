# Database (Postgres 16). Local dev example:
DATABASE_URL="postgresql://ua:ua@localhost:5432/used_artifacts"
# Disposable database for `npm run test:integration` (it is wiped on every run).
TEST_DATABASE_URL="postgresql://ua:ua@localhost:5432/used_artifacts_test"

APP_URL="http://localhost:3000"
# Required in production (32+ chars): openssl rand -base64 48
IP_HASH_SECRET=""

# Email. Without a Postmark token, dev prints emails (with links) to the server log.
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM="Used Artifacts <no-reply@usedartifacts.com>"

# One-time Proprietor assignment: npm run proprietor:assign
PROPRIETOR_EMAIL=""

# Economics (BUILD_PLAN.md section 0.1). bps = basis points, 100 bps = 1%.
PLATFORM_FEE_BPS_FREE=1000
PLATFORM_FEE_BPS_PAID=500
PAID_TIER_PRICE_CENTS=2000
REFERRAL_BPS=500
REFERRAL_CAP_AT_PLATFORM_FEE=true
ESCROW_AUTO_RELEASE_DAYS=3
AUCTION_PAYMENT_WINDOW_HOURS=48

# Platform
ENABLED_VERTICALS=ARTIFACT
HIGH_VALUE_THRESHOLD_CENTS=50000
BETA_FOUNDER_LIMIT=100
