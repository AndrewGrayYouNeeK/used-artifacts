# Database (Postgres 16). Local dev example:
DATABASE_URL="postgresql://ua:ua@localhost:5432/used_artifacts"
# Disposable database for `npm run test:integration` (it is wiped on every run).
TEST_DATABASE_URL="postgresql://ua:ua@localhost:5432/used_artifacts_test"

APP_URL="http://localhost:3000"
# Required in production (32+ chars): openssl rand -base64 48
IP_HASH_SECRET=""

# Email. Without a Postmark token, dev prints emails (with links) to the server log.
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM="Used Artifacts <no-reply@usedartifacts.com>"

# Identity verification (Stripe Identity). Leave both Stripe values empty in dev to use the
# local simulated provider (/account/verify/dev). Production refuses the simulator.
# The key needs Identity write access plus sensitive verification-result access (ask Stripe).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint /api/webhooks/stripe-identity
# (events: identity.verification_session.processing / verified / requires_input / canceled).
STRIPE_IDENTITY_WEBHOOK_SECRET=""
# Required in production (32+ chars). Never rotate: it keys the one-identity-per-account fingerprints.
IDENTITY_FINGERPRINT_SECRET=""

# Payments (Stripe Connect Express, separate charges and transfers). Defaults to the local simulator
# (/checkout/dev/...) when STRIPE_SECRET_KEY is empty; production refuses the simulator.
# PAYMENTS_PROVIDER="fake" forces the simulator in dev even with a Stripe key set.
PAYMENTS_PROVIDER=""
# Signing secret of the webhook endpoint /api/webhooks/stripe (Connect + account events:
# checkout.session.completed, checkout.session.expired, account.updated, charge.dispute.created).
STRIPE_WEBHOOK_SECRET=""
# true once Stripe Tax is set up (marketplace facilitator tax, L10). Off = no tax collected.
STRIPE_AUTOMATIC_TAX=false
# Required in production (32+ chars). Keys the device, card, and address linkage hashes.
LINKAGE_HASH_SECRET=""

# Listing photos. local = .data/uploads served by /api/files (dev only). s3 works with AWS S3 or
# Cloudflare R2 (set S3_ENDPOINT to https://<account>.r2.cloudflarestorage.com, region "auto").
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=".data/uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public CDN base for the bucket, e.g. https://photos.usedartifacts.com
STORAGE_PUBLIC_BASE_URL=""

# Shipment tracking. manual = staff confirm delivery in /admin/orders. easypost = carrier webhooks
# to /api/webhooks/easypost drive delivery and the auto-release timer.
SHIPPING_TRACKER=manual
EASYPOST_API_KEY=""
EASYPOST_WEBHOOK_SECRET=""

# Photo analyzer (Claude vision). Without a key, dev uses canned suggestions; production refuses
# the simulator. Use a zero-data-retention arrangement for seller photos (L11).
AI_VISION_PROVIDER=""
ANTHROPIC_API_KEY=""
AI_VISION_MODEL="claude-sonnet-4-5"

# Bearer token for /api/cron/* (Vercel Cron sends it automatically). Required in production.
CRON_SECRET=""

# One-time Proprietor assignment: npm run proprietor:assign
PROPRIETOR_EMAIL=""

# Economics (BUILD_PLAN.md section 0.1). bps = basis points, 100 bps = 1%.
# Buyer fee is built into the shown price; seller fee is deducted from the payout.
BUYER_FEE_BPS=1000
SELLER_FEE_BPS=1000
REFERRAL_BPS=500
# BUYER_PRICE or ASKING_PRICE: which amount the referral percentage applies to.
REFERRAL_BASIS=BUYER_PRICE
REFERRAL_CAP_AT_PLATFORM_FEE=true
ESCROW_AUTO_RELEASE_DAYS=3
# Unshipped paid orders are refunded after this many days.
SELLER_SHIP_BY_DAYS=5
# An unpaid checkout reserves the listing this long (minimum 30, Stripe's floor).
CHECKOUT_HOLD_MINUTES=60
AUCTION_PAYMENT_WINDOW_HOURS=48

# Platform
ENABLED_VERTICALS=ARTIFACT
HIGH_VALUE_THRESHOLD_CENTS=50000
BETA_FOUNDER_LIMIT=100
# Stays false until Kentucky auctioneer licensing (BUILD_PLAN L1) is answered.
AUCTIONS_ENABLED=false
